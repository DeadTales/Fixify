# Node >=22. No guardar credenciales reales en Git.
PORT=3008
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# Configura la versión habilitada para tu aplicación de Meta; no usar una versión antigua de la plantilla.
META_API_VERSION=
# demo permite probar el diálogo; api exige el endpoint del contrato propuesto.
CHATBOT_MODE=demo
# Remitente de pruebas autorizado en Meta, exactamente como llega en ctx.from (sin +).
DEMO_PHONE_NUMBER=
# En api, base del Backend incluyendo el prefijo versionado si corresponde.
BACKEND_URL=http://localhost:8000/api/v1/
BACKEND_BOT_TOKEN=
